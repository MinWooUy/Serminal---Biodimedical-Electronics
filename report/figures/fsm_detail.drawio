" as="geometry"/></mxCell><mxCell id="k28" value="crc = CRC-16/CCITT over CMD … PAYLOAD · payload is published only when the CRC passes · packet_valid / packet_error are one-cycle pulses · x = 1: output asserted while in the state · Arrow without label: unconditional." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="20" y="724" width="1300" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>