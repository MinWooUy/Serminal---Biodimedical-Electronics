 bản tin (little-endian, CRC phủ CMD..PAYLOAD)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="500" height="20" as="geometry"/></mxCell><mxCell id="t5-23" value="A5" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-24" value="5A" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-25" value="CMD" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="170" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-26" value="SEQ" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-27" value="LEN_LO" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="310" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-28" value="LEN_HI" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-29" value="PAYLOAD&lt;br&gt;(LEN byte)" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="450" y="290" width="280" height="50" as="geometry"/></mxCell><mxCell id="t5-30" value="CRC_LO" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-31" value="CRC_HI" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="290" width="70" height="50" as="geometry"/></mxCell><mxCell id="t5-32" value="byte 0" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-33" value="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="100" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-34" value="2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="170" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-35" value="3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="240" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-36" value="4" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="310" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-37" value="5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="380" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-38" value="6 … 6+LEN−1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="450" y="345" width="280" height="20" as="geometry"/></mxCell><mxCell id="t5-39" value="6+LEN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="730" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-40" value="7+LEN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="800" y="345" width="70" height="20" as="geometry"/></mxCell><mxCell id="t5-41" value="" style="rounded=0;whiteSpace=wrap;html=1;shape=bracket;direction=south;" vertex="1" parent="1"><mxGeometry x="170" y="372" width="560" height="12" as="geometry"/></mxCell><mxCell id="t5-42" value="CRC16-CCITT tính trên các byte này (khởi tạo 0xFFFF, từng byte: crc16_ccitt_next)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#FF0000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="170" y="388" width="560" height="20" as="geometry"/></mxCell><mxCell id="t5-43" value="&lt;b&gt;Ví dụ khung phản hồi ACK cho SWAP (cmd 0x0C, seq = s)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="440" width="500" height="20" as="geometry"/></mxCell><mxCell id="t5-44" value="A5" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-45" value="5A" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-46" value="80" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="170" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-47" value="s" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-48" value="02" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="310" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-49" value="00" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-50" value="0C" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-51" value="00" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-52" value="CRC_LO" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-53" value="CRC_HI" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="480" width="70" height="40" as="geometry"/></mxCell><mxCell id="t5-54" value="ACK 0x80 · LEN = 2 · payload = [cmd, 0]. NACK 0x81: payload = [cmd, mã lỗi]. RESULT 0x82: payload tuỳ lệnh." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="530" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="t6" name="T6_Lenh_va_payload"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t6-2" value="&lt;b&gt;Bảng lệnh (payload little-endian)&lt;/b&gt;&lt;br&gt;&lt;table border='1' cellpadding='3' style='border-collapse:collapse;font-size:11px'&gt;&lt;tr&gt;&lt;th&gt;Mã&lt;/th&gt;&lt;th&gt;Lệnh&lt;/th&gt;&lt;th&gt;Payload&lt;/th&gt;&lt;th&gt;Điều kiện hợp lệ (sai → NACK 2 nếu không ghi khác)&lt;/th&gt;&lt;th&gt;Phản hồi&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x08&lt;/td&gt;&lt;td&gt;WRITE_X&lt;/td&gt;&lt;td&gt;addr:u16, data[n]&lt;/td&gt;&lt;td&gt;len ≥ 3; addr+n ≤ IFMAP_MEM_DEPTH (4096)&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x09&lt;/td&gt;&lt;td&gt;WRITE_W&lt;/td&gt;&lt;td&gt;addr:u16, data[n]&lt;/td&gt;&lt;td&gt;len ≥ 3; addr+n ≤ WGT_MEM_DEPTH (16384)&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0A&lt;/td&gt;&lt;td&gt;WRITE_BIAS&lt;/td&gt;&lt;td&gt;base:u16, int32[n]&lt;/td&gt;&lt;td&gt;len ≥ 6; (len−2) chia hết 4; base+n ≤ BIAS_DEPTH (256)&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0B&lt;/td&gt;&lt;td&gt;WRITE_SHIFT&lt;/td&gt;&lt;td&gt;base:u16, int8[n]&lt;/td&gt;&lt;td&gt;len ≥ 3; base+n ≤ 2·COUT_MAX (128)&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0C&lt;/td&gt;&lt;td&gt;SWAP&lt;/td&gt;&lt;td&gt;flags:u8 (bit0 x, bit1 w)&lt;/td&gt;&lt;td&gt;len = 1; bit 7:2 = 0; layer_busy → NACK 3&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0D&lt;/td&gt;&lt;td&gt;CONFIG&lt;/td&gt;&lt;td&gt;11 / 12 / 16 byte (xem bên dưới)&lt;/td&gt;&lt;td&gt;kiểm tra tham số + cờ; busy → NACK 3&lt;/td&gt;&lt;td&gt;ACK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0E&lt;/td&gt;&lt;td&gt;RUN&lt;/td&gt;&lt;td&gt;rỗng&lt;/td&gt;&lt;td&gt;len = 0; chưa CONFIG hoặc busy → NACK 3&lt;/td&gt;&lt;td&gt;RESULT [status:u8, cycles:u32]&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x0F&lt;/td&gt;&lt;td&gt;READ_GAP&lt;/td&gt;&lt;td&gt;rỗng&lt;/td&gt;&lt;td&gt;len = 0; busy → NACK 3&lt;/td&gt;&lt;td&gt;RESULT COUT_MAX × u16&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x10&lt;/td&gt;&lt;td&gt;READ_FMAP&lt;/td&gt;&lt;td&gt;offset:u16, len:u8&lt;/td&gt;&lt;td&gt;len(payload) = 3; len &gt; 0; offset+len ≤ IFMAP_MEM_DEPTH; busy → NACK 3&lt;/td&gt;&lt;td&gt;RESULT len byte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x15&lt;/td&gt;&lt;td&gt;INFO&lt;/td&gt;&lt;td&gt;rỗng&lt;/td&gt;&lt;td&gt;len = 0&lt;/td&gt;&lt;td&gt;RESULT 22 byte&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0x11–0x14&lt;/td&gt;&lt;td&gt;(dành riêng)&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;chưa có nhánh xử lý&lt;/td&gt;&lt;td&gt;NACK 4&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1180" height="420" as="geometry"/></mxCell><mxCell id="t6-3" value="&lt;b&gt;Mã NACK&lt;/b&gt;: 1 = lỗi khung / CRC · 2 = tham số sai · 3 = sai trạng thái · 4 = lệnh lạ. (Chú thích đầu file RTL ghi '3 lệnh lạ' nhưng mã thật trả về là 4.)" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="1180" height="36" as="geometry"/></mxCell><mxCell id="t6-4" value="&lt;b&gt;CONFIG – payload 16 byte (11 byte: thiếu flags, w_base, b_base; 12 byte: thiếu w_base, b_base)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="800" height="20" as="geometry"/></mxCell><mxCell id="t6-5" value="out_len" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="30" y="550" width="140" height="40" as="geometry"/></mxCell><mxCell id="t6-6" value="0–1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="140" height="20" as="geometry"/></mxCell><mxCell id="t6-7" value="cout" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="170" y="550" width="140" height="40" as="geometry"/></mxCell><mxCell id="t6-8" value="2–3" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="170" y="595" width="140" height="20" as="geometry"/></mxCell><mxCell id="t6-9" value="k_len" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="310" y="550" width="140" height="40" as="geometry"/></mxCell><mxCell id="t6-10" value="4–5" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="310" y="595" width="140" height="20" as="geometry"/></mxCell><mxCell id="t6-11" value="window_step" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="450" y="550" width="140" height="40" as="geometry"/></mxCell><mxCell id="t6-12" value="6–7" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="450" y="595" width="140" height="20" as="geometry"/></mxCell><mxCell id="t6-13" value="pool" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="550" width="70" height="40" as="geometry"/></mxCell><mxCell id="t6-14" value="8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="590" y="595" width="70" height="20" as="geometry"/></mxCell><mxCell id="t6-15" value="gap" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="550" width="70" height="40" as="geometry"/></mxCell><mxCell id="t6-16" value="9" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="660" y="595" width="70" height="20" as="geometry"/></mxCell><mxCell id="t6-17" value="pad_next" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="730" y="550" width="70" height="40" as="geometry"/></mxCell><mxCell id="t6-18" value="10" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1"><mxGeometry x="730" y="595" width="70" height="20" as="geometry"/></mxCell><mxCell id="t6-19" value="flags" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="550" width="70" height="40" as="geometry"/></mxCell><mxCell id="t6-20" value="11" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=ce