&lt;/td&gt;&lt;td&gt;index = count−4 → SEND, ngược lại index+4&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SWAP&lt;/td&gt;&lt;td&gt;x_swap = swap_x, w_swap = swap_w&lt;/td&gt;&lt;td&gt;→ SEND&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RUN_START&lt;/td&gt;&lt;td&gt;layer_start = 1; cycle_cnt+1&lt;/td&gt;&lt;td&gt;→ RUN_WAIT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RUN_WAIT&lt;/td&gt;&lt;td&gt;cycle_cnt+1 mỗi chu kỳ&lt;/td&gt;&lt;td&gt;layer_done: nạp RESULT [status, cycles] → SEND&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RD_GAP&lt;/td&gt;&lt;td&gt;gap_rd_idx = index; ghi payload[index·16 +: 16]&lt;/td&gt;&lt;td&gt;index = COUT_MAX−1 → SEND&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RD_FMAP_ISSUE&lt;/td&gt;&lt;td&gt;dbg_rd_en = 1; dbg_rd_addr = address+index&lt;/td&gt;&lt;td&gt;→ RD_FMAP_WAIT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RD_FMAP_WAIT&lt;/td&gt;&lt;td&gt;chờ dbg_rd_valid; lưu 1 byte&lt;/td&gt;&lt;td&gt;hết → SEND, chưa hết → ISSUE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SEND&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;!tx_busy: o_tx_start = 1 → TX_LAUNCH&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TX_LAUNCH&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;→ TX_WAIT&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TX_WAIT&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;!tx_busy → IDLE&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;whiteSpace=wrap;overflow=fill;align=left;verticalAlign=top;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="560" width="1180" height="380" as="geometry"/></mxCell><mxCell id="t4-34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#FF6666;strokeWidth=2;arcSize=6;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1220" height="540" as="geometry"/></mxCell><mxCell id="t4-35" value="layer_cmd_controller (12 trạng thái, mã hoá 4 bit, Stop-and-Wait)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontStyle=1;fontColor=#FF6666;fontSize=13;" vertex="1" parent=